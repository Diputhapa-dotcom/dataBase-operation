<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="blog.css">
</head>
<body>

    <section>
     <% datas.forEach((data)=>{ %>

          <div class="card">
              <img src="<%-data.image%>">
              <h4><%-data.username %></h4>
              <p><%-data.email %></p>
            </div>
        <%})%>
    </section>
</body>
</html>