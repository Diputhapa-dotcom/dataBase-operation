<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <table border="n">

        <tr>
            <th>username</th>
            <th>email</th>
            <th>password</th>
        </tr>
        <% datas.forEach((data)=>{ %>

            <tr>
                <td><%-data.username %></td>
                <td><%-data.email %></td>
                <td><%-data.password %></td>
                <td><a href="/update/<%-data.id %>">update</a></td>
            </tr>
            <% }) %>
    </table>
</body>
</html>